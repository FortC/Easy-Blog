# /etc/easyblog.env — easyblog-server 环境变量（chmod 600 保护）
# Docker 部署不需要本文件：环境变量直接写在 docker-compose.yml / .env 里

# ---- 必配 ----
ADMIN_PASSWORD=换成一个足够长的密码          # 站长登录密码，不配则后台禁用
SITE_ROOT=/var/www/easyblog                 # 站点源码目录（含 content/ layouts/ hugo.yaml）
LISTEN=127.0.0.1:8788

# ---- 自动构建（后台发布依赖） ----
HUGO_BIN=/usr/local/bin/hugo

# ---- 静态托管（可选：不用 nginx 时让服务直接托管 public/） ----
#STATIC_SERVE=1

# ---- AI 助手（可选，三选一取消注释） ----
# OpenAI
#AI_PROVIDER=openai
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini
#AI_API_KEY=sk-xxxx
# 智谱 GLM（国内直连、有免费档）
#AI_PROVIDER=openai
#AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#AI_MODEL=glm-4-flash
#AI_API_KEY=xxxx.xxxx
# Anthropic Claude
#AI_PROVIDER=anthropic
#AI_BASE_URL=https://api.anthropic.com
#AI_MODEL=claude-sonnet-4-5
#AI_API_KEY=sk-ant-xxxx
AI_MAX_TOKENS=1024

# ---- 安全（可选） ----
# 会话签名密钥（默认用 ADMIN_PASSWORD；建议设成另一个随机串）
#ADMIN_SECRET=随机长字符串
# AI 接口 Referer 白名单，如 https://your-domain.com（空 = 不校验）
#ALLOWED_ORIGIN=https://your-domain.com
