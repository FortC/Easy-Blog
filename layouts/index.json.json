{{- /* 搜索索引：/index.json */}}
[
{{- $posts := where site.RegularPages "Section" "posts" }}
{{- range $i, $p := $posts }}
{{- if $i }},{{ end }}
  {"title":{{ $p.Title | jsonify }},"url":{{ $p.RelPermalink | jsonify }},"date":{{ $p.Date.Format "2006-01-02" | jsonify }},"tags":{{ $p.Params.tags | default slice | jsonify }},"summary":{{ $p.Summary | plainify | chomp | jsonify }},"content":{{ $p.Plain | truncate 800 | jsonify }}}
{{- end }}
]
