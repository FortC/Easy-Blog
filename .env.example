# 复制本文件为 .env 再改（.env 已被 .gitignore 和 .dockerignore 排除，不会泄漏）

# 站长后台登录密码（必填，请换成足够长的随机串）
ADMIN_PASSWORD=change-me-to-a-long-random-password

# 对外端口（默认 8080）
PORT=8080

# 会话签名密钥（可选，默认用 ADMIN_PASSWORD；建议设成另一个随机串）
#ADMIN_SECRET=

# ---- AI 助手（可选，三选一取消注释；配好后把 hugo.yaml 里 params.ai.enabled 改成 true） ----

# OpenAI
#AI_PROVIDER=openai
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini
#AI_API_KEY=sk-xxxx

# 智谱 GLM（国内直连、有免费档）
#AI_PROVIDER=openai
#AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#AI_MODEL=glm-4-flash
#AI_API_KEY=xxxx.xxxx

# Anthropic Claude
#AI_PROVIDER=anthropic
#AI_BASE_URL=https://api.anthropic.com
#AI_MODEL=claude-sonnet-4-5
#AI_API_KEY=sk-ant-xxxx

# AI_MAX_TOKENS=1024
# ALLOWED_ORIGIN=https://your-domain.com
